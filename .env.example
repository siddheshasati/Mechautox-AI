# LLM API Configuration

# Groq API Key (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Cohere API Key (https://dashboard.cohere.ai/api-keys)
COHERE_API_KEY=your_cohere_api_key_here

# Optional API Keys

# Hugging Face Token (for advanced models)
HUGGINGFACE_API_KEY=your_huggingface_token_here

# Replicate API Token (for image generation)
REPLICATE_API_TOKEN=your_replicate_token_here

# Application Configuration
# Your name (displayed in chat)
Username=Siddhesh

# Assistant name (displayed in responses)
Assistantname=MechautoX

# Advanced Configuration (Optional)

# Model selection (default: "mixtral-8x7b-32768")
# MODEL_NAME=mixtral-8x7b-32768

# Temperature for LLM (0.0 - 2.0, default: 0.7)
# TEMPERATURE=0.7

# Max tokens in response (default: 2048)
# MAX_TOKENS=2048

# Enable voice output (true/false, default: true)
# ENABLE_VOICE=true

# Enable image generation (true/false, default: true)
# ENABLE_IMAGE_GENERATION=true

# Database Configuration (Optional)

# Vector database path (default: Backend/Data/faiss_index/)
# FAISS_INDEX_PATH=Backend/Data/faiss_index/

# Chat log location (default: Data/ChatLog.json)
# CHAT_LOG_PATH=Data/ChatLog.json
